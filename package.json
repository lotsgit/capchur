{
    "name": "capchur",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.18.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev:extension": "corepack pnpm --filter @capchur/extension dev",
        "dev:web": "corepack pnpm --filter @capchur/web dev",
        "build": "corepack pnpm --recursive build",
        "typecheck": "corepack pnpm --filter @capchur/extension compile && corepack pnpm --filter @capchur/web exec tsc --noEmit",
        "lint": "corepack pnpm --filter @capchur/web lint"
    }
}