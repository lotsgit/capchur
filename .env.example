# Development-only bearer identity. Use a unique random token of at least 32 characters.
CAPCHUR_API_TOKENS={"replace-with-a-random-development-token":"local-owner"}
CAPCHUR_SIGNING_SECRET=replace-with-a-separate-random-secret

# Password recovery. Keep the provider key server-side and use a verified sender domain.
# RESEND_API_KEY=replace-with-email-provider-key
# CAPCHUR_EMAIL_FROM=Capchur <account@capchur.io>

# Public browser extension listings. Omit until the store has published each package.
# CHROME_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/...
# FIREFOX_EXTENSION_STORE_URL=https://addons.mozilla.org/firefox/addon/...

# Optional. Without DATABASE_URL, development uses persistent PGlite under apps/web/.data.
# DATABASE_URL=postgres://capchur:capchur@localhost:5432/capchur
# CAPCHUR_DATA_DIR=D:/path/to/private/capchur-data

# Production S3-compatible storage. Standard AWS credential environment variables apply.
# S3_BUCKET=capchur-images
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false

# Optional server-side AI (description, notes, and introduction enhancement). Disabled unless
# both key and model are set. Powers the free "online" AI notes option; defaults target OpenRouter,
# which hosts several ":free" models at no cost. CAPCHUR_AI_MODEL is an ordered, comma-separated
# fallback list: on a 429 from the current model, the next one is tried automatically. Check each
# candidate model/provider's published data-retention (no-logging/no-training) policy on OpenRouter
# and prefer those for the first entry - the free-model lineup changes over time.
# CAPCHUR_AI_API_KEY=replace-with-provider-api-key
# CAPCHUR_AI_MODEL=deepseek/deepseek-chat-v3.1:free,meta-llama/llama-3.3-70b-instruct:free
# CAPCHUR_AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# CAPCHUR_AI_TIMEOUT_MS=4000
# CAPCHUR_AI_REQUESTS_PER_MINUTE=10
# CAPCHUR_AI_REQUESTS_PER_DAY=200
# OpenRouter's recommended attribution headers (HTTP-Referer / X-Title); optional for other providers.
# CAPCHUR_AI_APP_URL=https://capchur.io
# CAPCHUR_AI_APP_NAME=Capchur
# Provider prices in millionths of the billing currency per one million tokens (0 for free models).
# CAPCHUR_AI_INPUT_COST_MICROS_PER_MILLION=0
# CAPCHUR_AI_OUTPUT_COST_MICROS_PER_MILLION=0