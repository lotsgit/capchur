# Development-only bearer identity. Use a unique random token of at least 32 characters.
CAPCHUR_API_TOKENS={"replace-with-a-random-development-token":"local-owner"}
CAPCHUR_SIGNING_SECRET=replace-with-a-separate-random-secret

# Optional. Without DATABASE_URL, development uses persistent PGlite under apps/web/.data.
# DATABASE_URL=postgres://capchur:capchur@localhost:5432/capchur
# CAPCHUR_DATA_DIR=D:/path/to/private/capchur-data

# Production S3-compatible storage. Standard AWS credential environment variables apply.
# S3_BUCKET=capchur-images
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false