{
  "name": "@capchur/extension",
  "description": "Capchur browser workflow recorder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:browsers": "wxt build && wxt build -b firefox",
    "browsers:install": "playwright install chromium firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:browsers": "wxt zip && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node e2e/capture-browser.mjs",
    "test:browser:chromium": "node e2e/capture-browser.mjs chromium",
    "test:screenshot:chromium": "node e2e/screenshot-browser.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@capchur/capture-core": "workspace:*",
    "@capchur/contracts": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^20.11.1",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.3"
  }
}