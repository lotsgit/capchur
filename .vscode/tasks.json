{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Capchur: Web dev",
            "type": "shell",
            "command": "corepack pnpm run dev:web",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "group": "capchur-dev",
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Capchur: Extension dev",
            "type": "shell",
            "command": "corepack pnpm run dev:extension",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "group": "capchur-dev",
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Capchur: Build all",
            "type": "shell",
            "command": "corepack pnpm run build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "Capchur: Check all",
            "type": "shell",
            "command": "corepack pnpm run typecheck; if ($LASTEXITCODE -eq 0) { corepack pnpm run lint }",
            "group": "test",
            "problemMatcher": [
                "$tsc",
                "$eslint-stylish"
            ]
        }
    ]
}